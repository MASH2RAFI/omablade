#!/usr/bin/env bash
set -euo pipefail

launcher=$(readlink -f -- "${BASH_SOURCE[0]}")
launcher_dir=$(cd -- "$(dirname -- "$launcher")" && pwd -P)
machine=$(uname -m)

candidates=()
if [[ -n ${OMABLADE_BINARY:-} ]]; then
  candidates+=("$OMABLADE_BINARY")
fi
if [[ $machine == x86_64 ]]; then
  candidates+=("$launcher_dir/omablade-bin")
fi
candidates+=(
  "$launcher_dir/bin/omablade"
  "$launcher_dir/target/release/omablade"
  "$launcher_dir/target/debug/omablade"
  /usr/bin/omablade-bin
)

for candidate in "${candidates[@]}"; do
  if [[ -f $candidate && -x $candidate && ! $candidate -ef $launcher ]]; then
    exec -- "$candidate" "$@"
  fi
done

if [[ $machine != x86_64 ]]; then
  printf 'omablade: the bundled backend is x86-64 only and this machine is %s; build one here with cargo build --release --locked, or set OMABLADE_BINARY to a backend for this machine\n' "$machine" >&2
  exit 126
fi
printf '%s\n' 'omablade: no compatible backend found; reinstall the plugin, set OMABLADE_BINARY, or install a package providing /usr/bin/omablade-bin' >&2
exit 127
