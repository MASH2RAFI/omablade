#!/usr/bin/env bash
set -euo pipefail

launcher=$(readlink -f -- "${BASH_SOURCE[0]}")
app_dir=$(cd -- "$(dirname -- "$launcher")" && pwd -P)
source_dir=$(cd -- "$app_dir/.." && pwd -P)
export OMABLADE_APP_ROOT=$source_dir
export OMABLADE_SOURCE_DIR=$source_dir
export OMABLADE_BINARY=$source_dir/bin/omablade
export OMABLADE_NATIVE_STATE_ROOT=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/omablade

[[ -x $OMABLADE_BINARY ]] || { printf 'omablade: native payload backend is unavailable: %s\n' "$OMABLADE_BINARY" >&2; exit 127; }
if [[ ${1:-} == _backend ]]; then
  shift
  exec "$OMABLADE_BINARY" native backend -- "$@"
fi
if [[ $# -gt 0 && ! ( $# -eq 2 && $1 == native && $2 == portal ) ]]; then
  exec "$OMABLADE_BINARY" "$@"
fi
for dependency in qs hyprctl setsid; do
  command -v "$dependency" >/dev/null || { printf 'omablade: required native capability is unavailable: %s\n' "$dependency" >&2; exit 127; }
done
if ! "$OMABLADE_BINARY" serve --native-probe >/dev/null 2>&1; then
  export OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}
  shell_deadline=$((SECONDS + 30))
  until timeout 2 qs ipc -n -p "$OMARCHY_PATH/shell" call -- shell listPlugins 2>/dev/null | jq -e 'type == "array" and length > 0' >/dev/null 2>&1; do
    if (( SECONDS >= shell_deadline )); then
      printf '%s\n' 'omablade: waiting for Omarchy plugin discovery timed out; start Omablade again after the shell is ready' >&2
      exit 1
    fi
    sleep 0.1
  done
  mkdir -p -- "$OMABLADE_NATIVE_STATE_ROOT"
  setsid -f "$OMABLADE_BINARY" serve --native-authority --max-concurrency 16 </dev/null >>"$OMABLADE_NATIVE_STATE_ROOT/authority.log" 2>&1
  for attempt in {1..100}; do
    "$OMABLADE_BINARY" serve --native-probe >/dev/null 2>&1 && break
    sleep 0.05
  done
fi
if ! "$OMABLADE_BINARY" serve --native-probe >/dev/null 2>&1; then
  printf 'omablade: native authority unavailable; inspect %s\n' "$OMABLADE_NATIVE_STATE_ROOT/authority.log" >&2
  exit 1
fi
if [[ $# -eq 2 ]]; then
  setsid -f qs -n -p "$app_dir" </dev/null >>"$OMABLADE_NATIVE_STATE_ROOT/view.log" 2>&1
  for attempt in {1..100}; do
    status=$("$OMABLADE_BINARY" native ipc -- omablade.native status 2>/dev/null || true)
    [[ $status == *'"loaded":true'* ]] && exec "$OMABLADE_BINARY" native portal
    sleep 0.05
  done
  printf 'omablade: native chooser view unavailable; inspect %s\n' "$OMABLADE_NATIVE_STATE_ROOT/view.log" >&2
  exit 1
fi
status=$("$OMABLADE_BINARY" native ipc -- omablade.native status 2>/dev/null || true)
if [[ $status == *'"loaded":true'* ]]; then
  exec "$OMABLADE_BINARY" native ipc -- mash2rafi.omablade.control open
fi
export OMABLADE_ACTIVATE=1
exec qs -n -p "$app_dir"
