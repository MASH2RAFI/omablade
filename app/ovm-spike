#!/usr/bin/env bash
set -euo pipefail
export OVM_HOME=$HOME/.local/share/test-omarchy-plugin-a
export OVM_SSH_PORT=2422
ovm=$HOME/.claude/skills/test-omarchy-plugin/scripts/ovm
native=/home/omarchy/omablade-runtime-spike
prelude='export OMABLADE_APP_ROOT=/home/omarchy/omablade-runtime-spike OMABLADE_BINARY=/home/omarchy/omablade-runtime-spike/target/release/omablade
export XDG_CONFIG_HOME=/home/omarchy/omablade-runtime-state/config XDG_STATE_HOME=/home/omarchy/omablade-runtime-state/state OMABLADE_NATIVE_STATE_ROOT=/home/omarchy/omablade-runtime-state/state/omarchy/omablade
omarchy-shell() {
  local args=("$@")
  if [[ ${1:-} == -q ]]; then shift; fi
  case ${1:-} in
    mash2rafi.omablade|mash2rafi.omablade.control) timeout 8 qs ipc -n -p /home/omarchy/omablade-runtime-spike/app call -- "$@" ;;
    *) command omarchy-shell "${args[@]}" ;;
  esac
}
'
case ${1:-} in
  ipc)
    shift
    case ${1:-} in
      mash2rafi.omablade|mash2rafi.omablade.control)
        printf -v command '%q ' timeout 8 qs ipc -n -p "$native/app" call -- "$@"
        exec "$ovm" ssh "$command"
        ;;
      *) exec "$ovm" ipc "$@" ;;
    esac
    ;;
  ssh)
    shift
    command=$*
    bindings=/home/omarchy/.config/omarchy/plugins/mash2rafi.omablade/examples/omablade-bindings.lua
    native_bindings="sed '1i hl.unbind(\"SUPER + B\")' $bindings | sed 's@omarchy-shell mash2rafi.omablade.control@qs -n -p $native/app ipc call mash2rafi.omablade.control@g'"
    command=${command//"cat $bindings"/"$native_bindings"}
    trash_query='~/.config/omarchy/plugins/mash2rafi.omablade/omablade _backend trash-list'
    command=${command//"$trash_query"/"$native/app/qualification/trash-list"}
    exec "$ovm" ssh "$prelude
$command"
    ;;
  restart-shell)
    "$ovm" ssh "timeout 5 qs -p '$native/app' kill || true
for attempt in {1..30}; do
  pgrep -f '^qs -n -p $native/app$' >/dev/null || break
  sleep 0.1
done" >/dev/null
    "$ovm" restart-shell
    exec "$ovm" ssh "setsid env OMABLADE_SPIKE_HOME=/home/omarchy/omablade-runtime-state '$native/app/qualification/launch' >/tmp/sootscale-native-authority-ui.log 2>&1 </dev/null &"
    ;;
  push|install|reset)
    printf '%s\n' 'omablade: stage the authorized native spike explicitly before using this expectation adapter' >&2
    exit 2
    ;;
  *) exec "$ovm" "$@" ;;
esac
