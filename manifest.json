{
  "schemaVersion": 1,
  "id": "mash2rafi.omablade",
  "name": "Omablade",
  "version": "0.3.3",
  "author": "MASH2RAFI",
  "license": "MIT",
  "repository": "https://github.com/mash2rafi/omablade",
  "minOmarchyVersion": "4.0.2",
  "description": "Customizable IDE-like sidebars for managing files and referencing information in Omarchy.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "ui/BladeBarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omablade",
    "description": "Open an Omablade pane from the bar",
    "category": "Plugin",
    "allowMultiple": false,
    "defaults": {
      "module": "notes",
      "width": 460,
      "height": 600
    },
    "schema": [
      {
        "key": "module",
        "type": "string",
        "label": "Module",
        "description": "Registered Omablade module to open",
        "maxLength": 128
      },
      {
        "key": "width",
        "type": "integer",
        "label": "Width",
        "min": 240,
        "max": 800,
        "step": 20
      },
      {
        "key": "height",
        "type": "integer",
        "label": "Height",
        "min": 160,
        "max": 1000,
        "step": 20
      }
    ]
  }
}
