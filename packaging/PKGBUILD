pkgname=omablade-native
pkgrel=1
pkgdesc='Omablade native runtime'
license=('MIT')
provides=('omablade')
conflicts=('omablade')
options=('!strip' '!debug')
source=('payload.tar' 'launch' 'omablade-native.hook')

package() {
  "$srcdir/payload/tools/native" verify "$srcdir/payload"
  mkdir -p "$pkgdir/usr/lib" "$pkgdir/usr/bin" "$pkgdir/usr/share/licenses/$pkgname"
  cp -a -- "$srcdir/payload" "$pkgdir/usr/lib/omablade"
  install -m 755 -- "$srcdir/launch" "$pkgdir/usr/bin/omablade"
  ln -s /usr/lib/omablade/bin/omablade "$pkgdir/usr/bin/omablade-bin"
  ln -s /usr/lib/omablade/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm 644 "$srcdir/omablade-native.hook" "$pkgdir/usr/share/libalpm/hooks/omablade-native.hook"
  install -Dm 644 /dev/null "$pkgdir/usr/share/omablade-native/lock"
}
