#!/bin/sh
set -eu
umask 077

json_string() {
  printf '"'
  printf '%s' "$1" | od -An -v -t u1 | while IFS= read -r line; do
    for byte in $line; do
      case "$byte" in
        8) printf '\\b' ;;
        9) printf '\\t' ;;
        10) printf '\\n' ;;
        12) printf '\\f' ;;
        13) printf '\\r' ;;
        34) printf '\\"' ;;
        92) printf '\\\\' ;;
        *)
          if [ "$byte" -lt 32 ]; then
            printf '\\u%04x' "$byte"
          else
            octal=$(printf '%03o' "$byte")
            printf "\\$octal"
          fi
          ;;
      esac
    done
  done
  printf '"'
}

selection="${OMABLADE_SELECTION_JSON:-}"
if [ -z "$selection" ] && [ -n "${OMABLADE_SELECTION_FILE:-}" ]; then
  selection=$(cat "$OMABLADE_SELECTION_FILE")
fi
[ -n "$selection" ] || selection='[]'

output="${OMABLADE_STATE_DIR:-.}/last.json"
count="${OMABLADE_SELECTION_COUNT:-0}"
case "$count" in *[!0-9]*|'') count=0 ;; esac
{
  printf '{"action":'
  json_string "${OMABLADE_ACTION:-}"
  printf ',"context":'
  json_string "${OMABLADE_CONTEXT:-}"
  printf ',"root":'
  json_string "${OMABLADE_ROOT:-}"
  printf ',"target":'
  json_string "${OMABLADE_TARGET:-}"
  printf ',"count":%s,"selection":%s}\n' "$count" "$selection"
} > "$output"

printf 'wrote %s\n' "$output"
